# Discord bot token (Bot -> Reset Token in the Developer Portal)
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID (General Information -> Application ID)
CLIENT_ID=your-application-id-here

# Optional: register slash commands to a single guild for instant updates
# during development. Leave empty to register commands globally (can take up
# to ~1 hour to propagate).
GUILD_ID=

# Optional: path to a Netscape-format cookies.txt for yt-dlp. Needed when
# YouTube blocks the host with "confirm you're not a bot" (common on cloud/
# datacenter IPs). See the README "YouTube cookies" section. With docker-compose
# this is set for you; only set it here for a bare `docker run` / local use.
# YT_DLP_COOKIES=/app/cookies.txt

# Optional: proxy URL for yt-dlp, as another way past the YouTube bot check.
# Use a RESIDENTIAL/MOBILE proxy — datacenter proxies get blocked too.
# Loaded automatically by docker-compose via this file.
# YT_DLP_PROXY=http://user:pass@host:port
