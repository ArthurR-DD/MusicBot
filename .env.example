# Discord bot token (Bot -> Reset Token in the Developer Portal)
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID (General Information -> Application ID)
CLIENT_ID=your-application-id-here

# Optional: register slash commands to a single guild for instant updates
# during development. Leave empty to register commands globally (can take up
# to ~1 hour to propagate).
GUILD_ID=

# Optional: folder scanned for audio files. Defaults to /app/music, which
# docker-compose maps to ./music on the host. Set this when running outside
# Docker, e.g. MUSIC_DIR=/home/you/Music
# MUSIC_DIR=/app/music

# Optional: how long (ms) the scanned file list is cached before rescanning,
# so newly added files are picked up without a restart. Default 60000.
# LIBRARY_TTL_MS=60000

# Optional: how long (ms) audio extraction from an uploaded video may run
# before it is killed. Default 600000 (10 minutes).
# EXTRACT_TIMEOUT_MS=600000

# --- Link playback (yt-dlp) ---------------------------------------------
# Pasting a link into /play streams it through yt-dlp. The Docker image sets
# YT_DLP_PATH to its bundled binary; the rest are only needed if a site starts
# refusing requests.

# Path to the yt-dlp binary. Set inside Docker already; only needed when
# running outside it and the bundled binary isn't wanted.
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# Format selector. Default "bestaudio/best".
# YT_DLP_FORMAT=bestaudio/best

# Netscape-format cookies.txt from a logged-in account, if a site asks you to
# "confirm you're not a bot". Rarely needed on a home/residential connection.
# YT_DLP_COOKIES=/app/cookies.txt

# Proxy URL for yt-dlp (residential/mobile — datacenter proxies get blocked).
# YT_DLP_PROXY=http://user:pass@host:port

# Extra extractor args, e.g. to pick a different YouTube player client if
# playback breaks: youtube:player_client=tv
# YT_DLP_EXTRACTOR_ARGS=

# --- Play history / radio -----------------------------------------------
# /radio shuffles the links played most often over this many days. Default 7.
# HISTORY_WINDOW_DAYS=7

# How many distinct tracks /radio queues. Default 25.
# RADIO_SIZE=25

# Where play history is stored. Defaults to a dot-file inside MUSIC_DIR, which
# is already writable and is skipped by the library scanner.
# HISTORY_FILE=/app/music/.play-history.json
